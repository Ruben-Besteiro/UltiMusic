    <string name="genius_setup_title">Hatua inahitajika</string>
    <string name="genius_setup_intro">Mfumo wa kujaza metadata kiotomatiki unatumia API ya Genius. Kwa sababu zilizo nje ya udhibiti wa UltiMusic, ili kutumia kipengele hiki lazima ufuate mchakato mfupi:</string>
    <string name="genius_setup_step1">1 - Fungua kiungo hiki na uingie kwenye akaunti yako:</string>
    <string name="genius_setup_step2">2 - Gusa New API Client na uweke yafuatayo:</string>
    <string name="genius_setup_field_name">App Name: UltiMusic</string>
    <string name="genius_setup_field_url">App Website URL: https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_step3">3 - Ukishamaliza, chini kabisa gusa Generate Access Token na unakili kinachoonekana. Itakaguliwa kiotomatiki ukigusa <b>Endelea</b>.</string>
    <string name="genius_setup_value_name">UltiMusic</string>
    <string name="genius_setup_url">https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_login_url">https://genius.com/api-clients</string>
    <string name="genius_setup_copy">Nakili</string>
    <string name="genius_setup_copied">Imenakiliwa</string>
    <string name="genius_setup_exit">Toka</string>
    <string name="genius_setup_continue">Endelea</string>
    <string name="genius_setup_checking">Inakagua tokeni…</string>
    <string name="genius_setup_ok">Tokeni imehifadhiwa</string>
    <string name="genius_setup_invalid">Tokeni hiyo si sahihi. Hakikisha umenakili Client Access Token, si Client ID wala Client Secret</string>
    <string name="genius_setup_no_token">Hakuna tokeni iliyonakiliwa. Nakili Client Access Token kisha gusa Endelea tena</string>
    <string name="genius_setup_no_browser">Hakuna kivinjari kilichopatikana cha kufungua kiungo</string>
    <string name="genius_setup_optional">Mchakato huu ni wa hiari, lakini ukiukataa, hutaweza kufaidika kikamilifu na kipengele hiki.</string>
    <string name="genius_error_title">Hitilafu ya API ya Genius</string>
    <string name="genius_error_message">Hitilafu imetokea kwenye API Client yako ya Genius. Ili kuendelea kufaidika kikamilifu na ujazaji kiotomatiki wa metadata, lazima uunde nyingine. Samahani kwa usumbufu.</string>
    <string name="youtube_setup_title">Hatua inahitajika</string>
    <string name="youtube_setup_intro">Kupanga kwa umaarufu kunatumia YouTube Data API. Kwa sababu zilizo nje ya udhibiti wa UltiMusic, ili kutumia kipengele hiki lazima ufuate mchakato mfupi:</string>
    <string name="youtube_setup_step1">1 - Fungua kiungo hiki na uunde mradi (au chagua ulio nao tayari):</string>
    <string name="youtube_setup_step2">2 - Katika Maktaba ya API, tafuta YouTube Data API v3 na uiwashe kwa mradi huo (kama haikuwa imewashwa). Hatua ya 3 itakuruhusu kuichagua tu ukiiwasha kwanza.</string>
    <string name="youtube_setup_step3">3 - Rudi kwenye mradi, gusa Unda kitambulisho na uchague YouTube Data API v3 mahali inapoombwa.</string>
    <string name="youtube_setup_step4">4 - Nakili ufunguo uliopewa katika hatua ya 3. Utakaguliwa kiotomatiki ukigusa <b>Endelea</b>.</string>
    <string name="youtube_setup_login_url">https://console.cloud.google.com/apis/credentials</string>
    <string name="youtube_setup_exit">Toka</string>
    <string name="youtube_setup_continue">Endelea</string>
