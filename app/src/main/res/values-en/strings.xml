    <!-- YouTube Data API setup ("Action required" dialog) -->
    <string name="youtube_setup_title">Action required</string>
    <string name="youtube_setup_intro">Sorting by popularity uses the YouTube Data API. For reasons beyond UltiMusic\'s control, you need to follow a short process to use this feature:</string>
    <string name="youtube_setup_step1">1 - Open this link and create a project (or choose one you already have):</string>
    <string name="youtube_setup_step2">2 - In the API Library, search for YouTube Data API v3 and enable it for that project (if it wasn\'t already). Step 3 will only let you choose it if you enable it first.</string>
    <string name="youtube_setup_step3">3 - Go back to the project, tap Create credentials and select YouTube Data API v3 when asked.</string>
    <string name="youtube_setup_step4">4 - Copy the key that step 3 gave you. It will be checked automatically when you tap <b>Continue</b>.</string>
    <string name="youtube_setup_login_url">https://console.cloud.google.com/apis/credentials</string>
    <string name="youtube_setup_exit">Exit</string>
    <string name="youtube_setup_continue">Continue</string>
    <string name="youtube_setup_checking">Checking the key…</string>
    <string name="youtube_setup_ok">Key saved</string>
    <string name="youtube_setup_invalid">That key isn\'t valid. Make sure you copied the API Key and that YouTube Data API v3 is enabled for its project</string>
