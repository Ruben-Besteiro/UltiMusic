<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia automática de Android para Android 11 o anterior (en Android 12+ manda
    data_extraction_rules.xml, que explica qué queda fuera y por qué). Mismas reglas que su
    <cloud-backup>: sin imágenes, por el límite de 25 MB.
-->
<full-backup-content>
    <include domain="database" path="ultimusic.db" />
    <include domain="database" path="ultimusic.db-wal" />
    <include domain="database" path="ultimusic.db-shm" />
    <include domain="file" path="playlists/" />
    <include domain="file" path="conversions/" />
    <include domain="file" path="translations/" />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="saf_storage.xml" />
</full-backup-content>
