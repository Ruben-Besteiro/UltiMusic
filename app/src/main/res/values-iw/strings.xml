    <string name="settings_eq_bass_boost_help_desc">מהי הגברת בס</string>
    <string name="settings_eq_bass_boost_help_title">הגברת בס</string>
    <string name="settings_eq_bass_boost_help_body">בניגוד להעלאת רצועת התדרים הנמוכה ביותר באקולייזר, אפקט זה פועל על כל טווח הבס, כולל תדרים נמוכים יותר מכפי שכל רצועה במכשיר הזה מכסה. במכשירים רבים הוא גם מוסיף הרמוניות, כך שהבס יישמע גם ברמקולים קטנים שאינם יכולים להשמיע תדרים נמוכים כל כך.</string>
    <string name="settings_eq_virtualizer_help_desc">מהו סאונד היקפי</string>
    <string name="settings_eq_virtualizer_help_title">סאונד היקפי</string>
    <string name="settings_eq_virtualizer_help_body">מרחיב את הסטריאו על ידי הדמיה של רמקולים נפרדים בצדדים. זו אינה התאמת עוצמה לפי תדר: הוא מערבב את הערוצים השמאלי והימני בדרך אחרת, כך שהצליל נשמע כאילו הוא מגיע מחוץ לראש. אף סליידר באקולייזר לא יכול להשיג אפקט זה, כי הם רק מעלים או מורידים רצועות תדרים באותה מידה בשני הערוצים.</string>
    <string name="settings_eq_reverb_title">הדהוד</string>
    <string name="settings_eq_reverb_help_desc">מהו הדהוד</string>
    <string name="settings_eq_reverb_help_title">הדהוד</string>
    <string name="settings_eq_reverb_help_body">מדמה את ההד של חלל (חדר, אולם, אודיטוריום…) על ידי הוספת הדהודים מושהים של הצליל. זהו אפקט בזמן, לא בתדר ולא בסטריאו: לא האקולייזר ולא הסאונד ההיקפי יכולים ליצור תחושת מרחב כזו. הרשימה הנפתחת בוחרת את גודל החדר; \"ללא\" מכבה אותו.</string>
