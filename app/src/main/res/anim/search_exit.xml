<?xml version="1.0" encoding="utf-8"?>
<!--
  Salida del buscador: la de entrada al revés. Baja hasta desaparecer por el borde inferior mientras
  se desvanece.

  Dura un poco menos que la entrada (300 ms frente a 350) a propósito: es la norma en las
  animaciones de interfaz: al abrir algo interesa que se vea llegar, al cerrarlo interesa quitarlo
  de en medio cuanto antes, porque el usuario ya ha decidido irse.

  El fundido lleva startOffset="80", o sea, no empieza hasta 80 ms después: así la pantalla se ve
  arrancar sólida y sólo se difumina cuando ya está a medio salir, en vez de volverse translúcida
  desde el primer fotograma.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <translate
        android:duration="300"
        android:fromYDelta="0"
        android:interpolator="@interpolator/emphasized_accelerate"
        android:toYDelta="100%p" />

    <alpha
        android:duration="220"
        android:fromAlpha="1.0"
        android:interpolator="@android:anim/linear_interpolator"
        android:startOffset="80"
        android:toAlpha="0.0" />

</set>
