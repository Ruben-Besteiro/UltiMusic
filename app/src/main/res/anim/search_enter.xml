<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrada del buscador, copiada de ~/Phonograph pero en vertical.

  En Phonograph la búsqueda es una Activity aparte y no declara ninguna animación propia: usa la que
  el sistema pone por defecto al abrir una pantalla encima de otra, que es un DESLIZAMIENTO
  HORIZONTAL (entra desde el borde derecho) acompañado de un fundido rápido. Aquí la búsqueda no es
  una Activity sino un diálogo a pantalla completa, y el resto de ventanas de UltiMusic (el iPod, el
  editor) entran desde abajo, así que se hace lo mismo pero por el eje vertical: sube desde el borde
  inferior mientras aparece.

  Un <set> agrupa varias animaciones que corren A LA VEZ. Con shareInterpolator="false" cada una
  lleva la suya, que es justo lo que hace falta: el desplazamiento dura 350 ms con la curva
  "emphasized" (frenazo largo al final), mientras que el fundido se despacha en 120 ms, porque si la
  transparencia durase lo mismo que el movimiento la pantalla se vería medio traslúcida demasiado
  rato y parecería un fantasma.

  "100%p" significa "el 100% del tamaño del padre" (la p es de parent), es decir: empieza una
  pantalla entera por debajo de su sitio.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <translate
        android:duration="350"
        android:fromYDelta="100%p"
        android:interpolator="@interpolator/emphasized_decelerate"
        android:toYDelta="0" />

    <alpha
        android:duration="120"
        android:fromAlpha="0.0"
        android:interpolator="@android:anim/linear_interpolator"
        android:toAlpha="1.0" />

</set>
