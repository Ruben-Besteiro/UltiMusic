<?xml version="1.0" encoding="utf-8"?>
<!--
  Curva "emphasized decelerate" de Material 3: la misma que usa Android para meter una pantalla nueva
  encima de otra. Un <pathInterpolator> describe cómo avanza una animación con una curva de Bézier:
  el eje X es el tiempo (de 0 a 1) y el eje Y el progreso (de 0 a 1). Con estos puntos de control la
  animación arranca disparada y frena mucho al final, que es lo que da la sensación de "algo pesado
  que llega y se posa" en vez de un desplazamiento a velocidad constante.
-->
<pathInterpolator xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.05"
    android:controlY1="0.7"
    android:controlX2="0.1"
    android:controlY2="1.0" />
