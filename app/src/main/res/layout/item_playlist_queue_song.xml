<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila de la lista de una playlist dentro del iPod en modo navegación. Si la canción que suena de
  verdad en la app está en esta playlist, se comporta como la cola real: esa fila lleva el icono de
  altavoz y el resto números relativos a ella. Si no, cada fila muestra su posición absoluta (1, 2,
  3…). A la derecha, "Título · Artista" y un manejador para arrastrar y reordenar. El fondo se
  resalta cuando es la fila seleccionada con las flechas (el "cursor" antes de pulsar play).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistQueueRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/queueSpeaker"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/ipod_now_playing"
            android:src="@drawable/ic_speaker"
            android:tint="@color/um_yellow"
            android:visibility="gone" />

        <TextView
            android:id="@+id/queueNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="14sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/queueSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/um_on_background"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/playlist_reorder_desc"
        android:src="@drawable/ic_drag_reorder"
        android:tint="@color/um_on_surface_muted" />

</LinearLayout>
