<?xml version="1.0" encoding="utf-8"?>
<!--
  Ficha de un álbum / artista / productor.

  La cabecera (toolbar + carátula + datos) es un bloque cuyo color de fondo se pone desde el código
  a partir de la carátula; por eso aquí arranca en negro y no lleva ningún color fijo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/um_surface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/detailToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextColor="@color/um_on_background"
            tools:title="Meteora" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- La carátula es cuadrada, así que el recuadro se calcula con SquareFrameLayout
                 (alto = ancho) en vez de con un tamaño fijo en dp: así queda cuadrada de verdad -->
            <com.untar.ultimusic.ui.common.SquareFrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/detailCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cover_placeholder"
                    android:contentDescription="@string/album_cover_desc"
                    android:scaleType="centerCrop" />

            </com.untar.ultimusic.ui.common.SquareFrameLayout>

            <!-- Las líneas (artista, nº canciones, duración, año) las añade el código: cuántas hay
                 depende del tipo de ficha y de qué metadatos existan. -->
            <LinearLayout
                android:id="@+id/detailInfoLines"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="0.55"
                android:gravity="center_vertical"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDetailSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:listitem="@layout/item_detail_song" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="@string/no_songs_here"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="16sp"
            android:visibility="gone" />

    </FrameLayout>

    <!--
      Única ventana a pantalla completa que también lleva mini-reproductor (ver
      DetailDialogFragment y MiniPlayerController): así se puede pausar, reanudar o abrir el iPod
      sin salir de la ficha que se está mirando.
    -->
    <SeekBar
        android:id="@+id/songProgress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_line"
        android:progressBackgroundTint="@color/um_divider"
        android:progressTint="@color/um_yellow"
        android:thumb="@null"
        android:splitTrack="false"
        android:background="@null"
        android:foreground="@android:color/transparent" />

    <include
        android:id="@+id/miniPlayer"
        layout="@layout/view_mini_player" />

</LinearLayout>
