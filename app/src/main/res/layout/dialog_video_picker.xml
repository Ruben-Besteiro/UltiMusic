<?xml version="1.0" encoding="utf-8"?>
<!-- Buscador de YouTube que se abre encima del iPod para elegir el videoclip de una canción. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/pickerToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/um_background"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/video_picker_title"
        app:titleTextColor="@color/um_on_background" />

    <!-- La página de YouTube se carga aquí dentro; nunca se sale de la aplicación. -->
    <WebView
        android:id="@+id/pickerWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
