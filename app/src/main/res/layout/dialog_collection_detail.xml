<?xml version="1.0" encoding="utf-8"?>
<!--
  Ficha de una lista, un género o una etiqueta (ver CollectionDetailDialogFragment). Misma idea que
  dialog_library_detail.xml (cabecera teñida con el acento de lo que suena + mini-reproductor
  propio abajo), pero sin carátula grande: ninguno de los tres tiene imagen propia, así que la
  cabecera es solo la barra superior más una línea con el resumen (nº de canciones + duración) y,
  solo para una lista, el bloque de "Posición actual"/REANUDAR debajo (ver collectionResumeBlock).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/collectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/um_surface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/collectionToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:titleTextColor="@color/um_on_background"
            tools:title="Rock" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/collectionSummaryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_timer" />

            <TextView
                android:id="@+id/collectionSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="15sp"
                tools:text="119 canciones | 7:38:27" />

        </LinearLayout>

        <!--
          Solo para una Lista (nunca género ni etiqueta, ver CollectionDetailDialogFragment): última
          canción reproducida DENTRO de ella, con un botón para reanudarla desde el principio. Oculto
          por defecto: aparece solo si hay algo guardado para esta lista (ver PlaylistResumeStore),
          y solo entonces btnResumePlaylist se oculta aparte mientras esta lista exacta esté sonando.
        -->
        <LinearLayout
            android:id="@+id/collectionResumeBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/collectionResumeIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note" />

            <TextView
                android:id="@+id/collectionResumeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                tools:text="Posición actual: Bohemian Rhapsody" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResumePlaylist"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:text="@string/playlist_resume"
                android:textSize="12sp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:iconPadding="4dp" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCollectionSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:listitem="@layout/item_collection_song" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:text="@string/no_songs_here"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <!--
          Botón "+" flotante, igual que btnCreateTag de fragment_tags.xml (mismo icono, mismo tinte
          dinámico): siempre visible en una lista, solo en una etiqueta con membresía real (ver
          TagsViewModel.isEditable), oculto en un género o una etiqueta calculada. Abre
          AddSongsToPlaylistDialogFragment o AddSongsToTagDialogFragment según toque (ver
          CollectionDetailDialogFragment.showAddSongs).
        -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAddSongs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/add_songs_desc"
            android:src="@android:drawable/ic_input_add"
            android:visibility="gone"
            app:backgroundTint="@color/um_yellow"
            app:tint="@color/um_background"
            tools:visibility="visible" />

    </FrameLayout>

    <!--
      Igual que dialog_library_detail.xml: mini-reproductor propio para poder pausar, reanudar o
      abrir el iPod sin salir de esta ficha (ver MiniPlayerController).
    -->
    <SeekBar
        android:id="@+id/songProgress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/seekbar_line_square"
        android:progressBackgroundTint="@color/um_divider"
        android:progressTint="@color/um_yellow"
        android:thumb="@null"
        android:splitTrack="false"
        android:background="@null"
        android:foreground="@android:color/transparent" />

    <include
        android:id="@+id/miniPlayer"
        layout="@layout/view_mini_player" />

</LinearLayout>
