<?xml version="1.0" encoding="utf-8"?>
<!--
  Cabecera de álbum dentro de la discografía (ver DiscographyDialogFragment/DiscographyAdapter):
  carátula + "Título - Año". El color del título lo pone el adaptador según si hay o no alguna
  canción de ese álbum en el dispositivo (blanco/gris, ver DiscographyViewModel.crossReference).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/discographyAlbumCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/cover_placeholder"
        android:contentDescription="@string/album_cover_desc"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/discographyAlbumTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Kill 'Em All - 1983"
        tools:textColor="@color/um_on_background" />

</LinearLayout>
