<?xml version="1.0" encoding="utf-8"?>
<!--
  Separador de sección de los resultados ("Canciones", "Álbumes", "Artistas", "Productores"). El
  fondo más oscuro que el de la lista es lo que hace que se lea como una franja y no como una fila
  más; el color del texto lo pone el adaptador, porque sigue al amarillo dinámico de lo que suena.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sectionTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/um_surface"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:textAllCaps="true"
    android:textSize="14sp"
    android:textStyle="bold"
    tools:text="Canciones" />
