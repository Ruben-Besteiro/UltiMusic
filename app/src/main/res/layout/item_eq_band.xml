<?xml version="1.0" encoding="utf-8"?>
<!--
  Una banda del ecualizador: un slider vertical (su recorrido va de minLevelMb a maxLevelMb, ver
  EqBand en PlayerViewModel.kt) y debajo su frecuencia central formateada ("60 Hz", "1.2 kHz"...).
  Se infla una vez por banda desde SettingsDialogFragment porque el número de bandas y su rango los
  decide el dispositivo, no son un número fijo de la aplicación.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.google.android.material.slider.Slider
        android:id="@+id/eqBandSlider"
        android:layout_width="wrap_content"
        android:layout_height="180dp"
        android:orientation="vertical"
        app:labelBehavior="gone" />

    <TextView
        android:id="@+id/eqBandFreq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/um_on_surface_muted"
        android:textSize="11sp"
        tools:ignore="SmallSp"
        tools:text="1.2 kHz" />

</LinearLayout>
