<?xml version="1.0" encoding="utf-8"?>

<!--
  Fila de canción de la pestaña «Canciones» y de la ficha de una lista o un género (ver
  item_collection_song.xml, que es esta misma fila con un manejador de arrastre delante). Subtítulo
  de dos líneas: el artista solo (puede ser una lista larga si hay varios) y, debajo, el resto
  -álbum y, si la canción tiene vídeo asignado, sus visitas de YouTube al final (ver SongsAdapter).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/songRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingVertical="10dp">


    <!-- Carátula + overlay de selección (ver SongsAdapter.bind): mientras hay canciones
         seleccionadas (pulsación larga), selectionScrim y selectionCheck se hacen visibles sobre
         la carátula de las que estén marcadas. selectionCheck se tiñe con el acento dinámico, como
         el resto de lo amarillo de la aplicación (ver bg_circle_selection.xml y CLAUDE.md). -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cover_placeholder"
            android:contentDescription="@string/album_cover_desc"
            android:scaleType="centerCrop"/>

        <View
            android:id="@+id/selectionScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/um_queue_scrim"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/selectionCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_selection"
            android:contentDescription="@string/song_selected_desc"
            android:padding="3dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/um_on_background"
            android:textSize="16sp"
            android:textStyle="italic"
            tools:text="AAAAAAAAAAAAAAAA" />

        <TextView
            android:id="@+id/songSubtitleArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="12sp"
            tools:text="Artista A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/songSubtitleRest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="12sp"
                tools:text="Álbum A" />

            <ImageView
                android:id="@+id/songYoutubeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_youtube"
                android:tint="@color/um_on_surface_muted"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/songYoutubeViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="123K"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnSongMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/song_more"
        android:src="@drawable/ic_more_vert" />

</LinearLayout>
