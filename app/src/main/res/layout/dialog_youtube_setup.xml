<?xml version="1.0" encoding="utf-8"?>
<!--
  Cuerpo del diálogo de "Acción requerida" que sale al elegir "Popularidad" en el diálogo de ordenar
  sin tener clave de la YouTube Data API (ver YouTubeApiKeyDialogFragment). El título y los botones
  "Salir"/"Continuar" los pone el AlertDialog, aquí solo va el contenido. Mismo patrón que
  dialog_genius_token.xml: un enlace para copiar/pegar en vez de escribir a mano.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/youtube_setup_intro"
            android:textColor="@color/um_on_background"
            android:textSize="15sp" />

        <!-- Paso 1: el enlace a la consola de Google Cloud. Se tiñe con el acento dinámico desde el
             fragmento (en el XML es amarillo, y la regla del proyecto es que todo lo amarillo use el
             color dinámico). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/youtube_setup_step1"
            android:textColor="@color/um_on_background"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/youtubeSetupLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/youtube_setup_login_url"
            android:textColor="@color/um_yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/youtube_setup_step2"
            android:textColor="@color/um_on_background"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/youtube_setup_step3"
            android:textColor="@color/um_on_background"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/youtube_setup_step4"
            android:textColor="@color/um_on_background"
            android:textSize="15sp" />

        <!-- Cierre: que se puede decir que no, y qué se pierde. Va en gris (no en el color de
             acento) porque es una aclaración, no una llamada a la acción. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/youtube_setup_optional"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- Resultado de la comprobación de la clave (validando / válida / no vale). Oculto hasta
             que hay algo que decir. -->
        <TextView
            android:id="@+id/youtubeSetupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
