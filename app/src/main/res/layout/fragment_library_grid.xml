<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña en rejilla (Álbumes). El nº de columnas lo pone el GridLayoutManager desde el código. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLibrary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="8dp"
        android:scrollbars="none"
        tools:listitem="@layout/item_album_card" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:gravity="center"
        android:textColor="@color/um_on_surface_muted"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
