<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila de canción en la ficha de una lista, un género o una etiqueta (ver
  CollectionDetailDialogFragment): igual que item_song.xml (misma carátula, título/subtítulo de dos
  líneas con visitas de YouTube y menú de 3 puntos), con un manejador de arrastre añadido delante que
  solo se ve en una lista (ver CollectionSongsAdapter.reorderable): un género no tiene orden propio
  que guardar.

  btnRemoveSong es la X que quita ESTA canción del destino, a la izquierda del menú de 3 puntos: en
  una lista siempre, en una etiqueta solo si tiene membresía real (ver TagsViewModel.isEditable) —
  oculta en un género o una etiqueta calculada. Su texto ("Quitar de la etiqueta"/"Quitar de la
  lista") lo pone CollectionSongsAdapter.setRemovable en tiempo de ejecución según toque; el string
  de aquí es solo el valor de fábrica/vista previa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/songRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/playlist_reorder_desc"
        android:src="@drawable/ic_drag_reorder"
        android:tint="@color/um_on_surface_muted" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/cover_placeholder"
        android:contentDescription="@string/album_cover_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/um_on_background"
            android:textSize="16sp"
            android:textStyle="italic"
            tools:text="AAAAAAAAAAAAAAAA" />

        <TextView
            android:id="@+id/songSubtitleArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="12sp"
            tools:text="Artista A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/songSubtitleRest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="12sp"
                tools:text="Álbum A" />

            <ImageView
                android:id="@+id/songYoutubeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_youtube"
                android:tint="@color/um_on_surface_muted"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/songYoutubeViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="123K"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRemoveSong"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove_song_from_tag_desc"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:tint="@color/um_on_surface_muted"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btnSongMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/song_more"
        android:src="@drawable/ic_more_vert" />

</LinearLayout>
