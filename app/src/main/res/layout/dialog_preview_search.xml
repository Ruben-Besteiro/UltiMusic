<?xml version="1.0" encoding="utf-8"?>
<!--
  Diálogo del buscador de fragmentos (ver PreviewSearchDialogFragment).

  Calco de dialog_lyrics_suggestions.xml: toolbar + barra de búsqueda + una superposición dentro de
  un FrameLayout, porque la lista, el indicador de carga y el mensaje de invitación/vacío/error
  nunca se ven a la vez (el fragmento cambia su visibilidad según el estado de la búsqueda).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/previewSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/previewSearchToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/um_background"
        app:navigationContentDescription="@string/editor_close"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/preview_search_title"
        app:titleTextColor="@color/um_on_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/um_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/previewSearchInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:hint="@string/preview_search_hint"
            android:imeOptions="actionSearch"
            android:includeFontPadding="false"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="@color/um_on_background"
            android:textColorHint="@color/um_on_surface_muted" />

        <ImageButton
            android:id="@+id/previewSearchButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_search"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            android:tint="@color/um_on_surface_muted" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/um_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/previewSearchList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:listitem="@layout/item_preview_track" />

        <!-- Su color se tiñe con el acento dinámico al arrancar (ver el fragmento): por defecto
             saldría del amarillo fijo de colorPrimary (ver themes.xml). -->
        <ProgressBar
            android:id="@+id/previewSearchLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/previewSearchMessageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/previewSearchMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/preview_search_idle"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previewSearchRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/suggestions_retry"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
