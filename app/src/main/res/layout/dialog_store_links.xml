<?xml version="1.0" encoding="utf-8"?>
<!--
  Contenido del diálogo de tiendas (ver StoreLinksDialogFragment). Carga, mensaje (vacío/error) y
  lista nunca se ven a la vez: el fragmento cambia su visibilidad según el estado de la búsqueda.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="8dp">

    <!-- Su color se tiñe con el acento dinámico (ver el fragmento): por defecto saldría del
         amarillo fijo de colorPrimary. -->
    <ProgressBar
        android:id="@+id/storeLinksLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="24dp" />

    <LinearLayout
        android:id="@+id/storeLinksMessageGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/storeLinksMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/storeLinksRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/suggestions_retry"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/storeLinksList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
