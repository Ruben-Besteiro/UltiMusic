<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor de metadatos de una canción, a pantalla completa.

  CoordinatorLayout mantiene la toolbar fija al hacer scroll sin que tape la imagen.
  La portada ocupa todo el ancho debajo de la toolbar; los campos están en una NestedScrollView.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/um_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/editorAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/editorToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@drawable/bg_toolbar_scrim"
            app:navigationContentDescription="@string/editor_close"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/metadata_editor_title"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Portada: cuadrada (SquareFrameLayout). Tocarla o el botón abajo-derecha abre el selector. -->

            <!-- ===== Campos principales: Título y Álbum(es), en su propio bloque de color ===== -->

            <com.untar.ultimusic.ui.common.SquareFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/editorCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cover_placeholder"
                    android:contentDescription="@string/editor_pick_cover"
                    android:scaleType="centerCrop" />

                <ImageButton
                    android:id="@+id/btnPickCover"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="@string/editor_pick_cover"
                    android:src="@drawable/ic_image" />

            </com.untar.ultimusic.ui.common.SquareFrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/um_surface_variant"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.UltiMusic.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/field_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutAlbums"
                    style="@style/Widget.UltiMusic.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/field_albums"
                    app:helperText="@string/multi_value_hint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputAlbums"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===== Resto de campos siempre visibles: Artista(s) y Productor(es) ===== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutArtists"
                    style="@style/Widget.UltiMusic.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/field_artists"
                    app:helperText="@string/multi_value_hint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputArtists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Igual que el de artistas: ahora los productores también son entidades con su
                     propia pestaña, así que ofrecen las sugerencias de los que ya existen. -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.UltiMusic.TextField.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/field_producers"
                    app:helperText="@string/multi_value_hint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputProducers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===== Detalles ===== -->

                <LinearLayout
                    android:id="@+id/sectionDetailsHeader"
                    style="@style/Widget.UltiMusic.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <TextView
                        style="@style/Widget.UltiMusic.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_details" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionDetailsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_year">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="4"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_genres"
                        app:helperText="@string/multi_value_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputGenres"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- FrameLayout para poder clavar la papelera en la esquina de ARRIBA: el icono
                         final propio de TextInputLayout se centra en el alto entero de la caja, que
                         con 10 líneas queda a media altura en vez de arriba. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.UltiMusic.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/field_lyrics"
                            app:helperText="@string/field_lyrics_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputLyrics"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:cursorVisible="false"
                                android:longClickable="false"
                                android:inputType="textMultiLine"
                                android:maxLines="10" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/btnClearLyrics"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/editor_clear_lyrics"
                            android:padding="4dp"
                            android:src="@drawable/ic_delete"
                            android:tint="@color/um_on_surface_muted" />
                    </FrameLayout>

                    <!-- Desplazamiento letra/audio (ver Song.lyricsOffsetMs): misma regla arrastrable
                         que la del vídeo, justo debajo de la letra a la que corrige. Solo tiene efecto
                         real con letra sincronizada (ver LrcParser); con letra sin sincronizar o sin
                         letra se puede tocar igualmente, pero no cambia nada visible. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/lyrics_offset_title"
                        android:textColor="@color/um_on_background"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lyrics_offset_subtitle"
                        android:textColor="@color/um_on_surface_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.untar.ultimusic.ui.common.ValueRuler
                            android:id="@+id/lyricsOffsetRuler"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginBottom="10dp"
                            android:contentDescription="@string/lyrics_offset_title" />

                        <EditText
                            android:id="@+id/lyricsOffsetValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:gravity="end"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned"
                            android:maxLength="6"
                            android:maxLines="1"
                            android:textColor="@color/um_on_background"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/video_settings_offset_unit"
                            android:textColor="@color/um_on_background" />

                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_language">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_comment">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputComment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Enlace del videoclip para el modo vídeo del iPod. Se puede dejar vacío: la
                         primera vez que se active el modo vídeo, el iPod abre un buscador de YouTube
                         y lo rellena con el que elija el usuario. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.UltiMusic.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/field_video_url"
                            app:helperText="@string/field_video_url_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputVideoUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:cursorVisible="false"
                                android:longClickable="false"
                                android:maxLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <ImageButton
                            android:id="@+id/btnClearVideoUrl"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/editor_clear_video_url"
                            android:padding="4dp"
                            android:src="@drawable/ic_delete"
                            android:tint="@color/um_on_surface_muted" />
                    </FrameLayout>

                    <!-- Enlace para abrir en YouTube el vídeo del campo de arriba. Solo aparece con
                         una URL reconocible dentro (ver YouTubeUrl.videoId); el color del texto y
                         del icono es el dinámico, igual que el resto de amarillos de esta pantalla
                         (ver el collect de accentColor). -->
                    <TextView
                        android:id="@+id/linkVideoUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:drawablePadding="6dp"
                        android:drawableStart="@drawable/ic_youtube"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="4dp"
                        android:text="@string/field_video_url_open"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Desplazamiento vídeo/audio del modo vídeo del iPod (ver Song.videoOffsetMs):
                         regla arrastrable igual que el amplificador de volumen sin límite (ver
                         ValueRuler). Antes vivía en unos ajustes aparte del propio iPod; ahora es un
                         campo más de este formulario, así que se aplica al guardar como el resto. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/video_settings_offset_title"
                        android:textColor="@color/um_on_background"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/video_settings_offset_subtitle"
                        android:textColor="@color/um_on_surface_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.untar.ultimusic.ui.common.ValueRuler
                            android:id="@+id/offsetRuler"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:contentDescription="@string/video_settings_offset_title" />

                        <EditText
                            android:id="@+id/offsetValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:gravity="end"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned"
                            android:maxLength="6"
                            android:maxLines="1"
                            android:textColor="@color/um_on_background"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/video_settings_offset_unit"
                            android:textColor="@color/um_on_background" />

                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Posición en el álbum ===== -->

                <LinearLayout
                    android:id="@+id/sectionPositionHeader"
                    style="@style/Widget.UltiMusic.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <TextView
                        style="@style/Widget.UltiMusic.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_album_position" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionPositionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_track_number">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputTrackNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_disc_number">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDiscNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- ===== Grabación original (campos og*) ===== -->

                <LinearLayout
                    android:id="@+id/sectionOriginalHeader"
                    style="@style/Widget.UltiMusic.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <TextView
                        style="@style/Widget.UltiMusic.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_original" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sectionOriginalContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_og_title">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputOgTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_og_artist">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputOgArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_og_album">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputOgAlbum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.UltiMusic.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/field_og_year">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputOgYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="4"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Varita de autorrelleno: al ser hermana del NestedScrollView (no está dentro), el scroll del
         formulario no la mueve de la esquina inferior derecha. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAutofill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/editor_autofill"
        android:src="@drawable/ic_wand"
        app:backgroundTint="@color/um_yellow"
        app:tint="@color/um_background" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
