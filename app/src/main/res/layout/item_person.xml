<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de Artistas / Productores: imagen circular + nombre + recuento. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/personImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/cover_placeholder"
        android:contentDescription="@string/person_image_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/personName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/um_on_background"
            android:textSize="16sp"
            android:textStyle="italic"
            tools:text="Linkin Park" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/personSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="14sp"
                tools:text="3 álbumes | 27 canciones" />

            <!-- Suscriptores del canal de YouTube más repetido entre las canciones donde esta
                 persona es la artista principal (ver PeopleAdapter/SearchAdapter y
                 PersonSummary.popularity); oculto sin dato, siempre oculto para un productor. Mismo
                 icono y formato compacto que las visitas de una canción (item_song.xml), sin texto
                 de reserva: la palabra "suscriptores" solo sale en la ficha de detalle. -->
            <ImageView
                android:id="@+id/personYoutubeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_youtube"
                android:tint="@color/um_on_surface_muted"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/personYoutubeSubscribers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="1.2M"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
