<?xml version="1.0" encoding="utf-8"?>
<!--
  Elemento del carrusel horizontal de álbumes en la ficha de un artista/productor
  (dialog_library_detail.xml): versión pequeña de item_album_card.xml (rejilla de la pestaña de
  Álbumes), con el año en el subtítulo en vez del artista. En la ficha de un ARTISTA la línea de
  artista se oculta (aquí siempre es el mismo, no aporta nada repetirlo); en la de un PRODUCTOR sí
  se ve, porque cada álbum puede ser de uno distinto (ver DetailAlbumsAdapter.showArtistLine).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="110dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="4dp">

    <com.untar.ultimusic.ui.common.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/albumCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cover_placeholder"
            android:contentDescription="@string/album_cover_desc"
            android:scaleType="centerCrop" />

    </com.untar.ultimusic.ui.common.SquareFrameLayout>

    <TextView
        android:id="@+id/albumTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/um_on_background"
        android:textSize="13sp"
        android:textStyle="italic"
        tools:text="AiAiA - Single" />

    <TextView
        android:id="@+id/albumSubtitleArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/um_on_surface_muted"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Artista A"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/albumSubtitleYear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/um_on_surface_muted"
        android:textSize="11sp"
        tools:text="2026" />

</LinearLayout>
