<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de canción de AddSongsToTagDialogFragment: checkbox real (MaterialCheckBox, mismo motivo
     que item_playlist_checkbox.xml sobre por qué no el setMultiChoiceItems de serie) en vez del menú
     de 3 puntos, y a un tamaño más pequeño que item_song.xml (carátula 40dp en vez de 56dp, textos
     más chicos): aquí solo hace falta identificar la canción para marcarla, no hay nada que tocar
     aparte. Toda la fila es clicable y alterna la casilla -no hace falta acertar justo en el
     cuadradito-, ver SongCheckboxAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/songCheckboxRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/songCheckboxCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:clickable="false"
        android:focusable="false"
        app:rippleColor="@color/um_ripple_white" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/cover_placeholder"
        android:contentDescription="@string/album_cover_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/songCheckboxTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/um_on_background"
            android:textSize="14sp"
            android:textStyle="italic"
            tools:text="AAAAAAAAAAAAAAAA" />

        <TextView
            android:id="@+id/songCheckboxSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="11sp"
            tools:text="Artista A | Álbum A" />

    </LinearLayout>

</LinearLayout>
