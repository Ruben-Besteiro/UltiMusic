<?xml version="1.0" encoding="utf-8"?>
<!--
  Celda de la rejilla de álbumes: carátula cuadrada + título + número de canciones + subtítulo de
  artista y año (ver AlbumsAdapter.AlbumViewHolder).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="8dp">

    <!--
      SquareFrameLayout fuerza que el alto sea igual al ancho. Hace falta porque el ancho de la
      celda lo decide el GridLayoutManager en tiempo de ejecución (depende de las columnas y de la
      pantalla), así que no se puede escribir una altura fija en el XML.
    -->
    <com.untar.ultimusic.ui.common.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/albumCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cover_placeholder"
            android:contentDescription="@string/album_cover_desc"
            android:scaleType="centerCrop" />
    </com.untar.ultimusic.ui.common.SquareFrameLayout>

    <TextView
        android:id="@+id/albumTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/um_on_background"
        android:textSize="16sp"
        android:textStyle="italic"
        tools:text="Meteora" />

    <TextView
        android:id="@+id/albumSongCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/um_on_surface_muted"
        android:textSize="12sp"
        tools:text="12 canciones" />

    <!--
      Sin `maxLines`: el artista puede ser una lista larga (álbumes con varios artistas) y aquí se
      ve entero, envuelva a las líneas que envuelva, en vez de cortarse con "…".

      `minLines="1"` (que ya es el valor por defecto de un TextView) se deja explícito solo para
      que un subtítulo vacío (`joinNonBlank` devolviendo "") no colapse a 0dp de alto y descuadre la
      fila más de lo necesario; no reserva una 2ª línea de más cuando no hace falta. Dos celdas de
      la misma fila con distinto número de líneas de subtítulo (una corta, la de al lado larga)
      pueden seguir dejando hueco en blanco bajo la corta -GridLayoutManager no iguala el alto de
      las celdas de una fila-, pero es un caso puntual, no el habitual.
    -->
    <TextView
        android:id="@+id/albumSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="1"
        android:textColor="@color/um_on_surface_muted"
        android:textSize="12sp"
        tools:text="Linkin Park | 2003" />

</LinearLayout>
