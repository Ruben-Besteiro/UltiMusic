<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila de la cola de reproducción. El "hueco" izquierdo muestra el icono de altavoz cuando es la
  canción que suena ahora, o el número de posición en el resto de filas (el adaptador alterna cuál).
  Debajo, un divisor que el adaptador solo muestra en la ÚLTIMA fila, y solo si la cola no llega a
  llenar la pantalla (ver IPodDialogFragment.refreshEndDivider): marca que ahí se acaba de verdad la
  cola, en vez de dejar ambiguo si el hueco en blanco de debajo es solo scroll sin usar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/queueSpeaker"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/ipod_now_playing"
                android:src="@drawable/ic_speaker"
                android:tint="@color/um_yellow"
                android:visibility="gone" />

            <TextView
                android:id="@+id/queueNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/um_on_surface_muted"
                android:textSize="14sp" />
        </FrameLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/queueCover"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/cover_placeholder"
            android:contentDescription="@string/album_cover_desc"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/queueSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/um_on_background"
            android:textSize="15sp" />

        <!-- Manejador para arrastrar y reordenar la cola tal cual está sonando (ver IPodQueueAdapter). -->
        <ImageView
            android:id="@+id/dragHandle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/playlist_reorder_desc"
            android:src="@drawable/ic_drag_reorder"
            android:tint="@color/um_on_surface_muted" />
    </LinearLayout>

    <!-- Divisor gris que marca el final de la cola (solo en la última fila, ver arriba). -->
    <View
        android:id="@+id/queueDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:background="@color/um_divider"
        android:visibility="gone" />

</LinearLayout>
