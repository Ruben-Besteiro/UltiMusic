<?xml version="1.0" encoding="utf-8"?>
<!--
  Cuerpo del diálogo de ordenar (ver SortDialogFragment). El título ("Ordenar <fragmento>") y los
  botones Cancelar/Aceptar los pone el AlertDialog; aquí van el grupo de radio buttons del criterio
  y, debajo, la casilla que invierte el orden natural de ese criterio (ver SortField.naturalDirection).

  Los cinco botones del grupo van SIEMPRE los cinco en el XML: el fragmento oculta
  (visibility=GONE) los que no valgan para la pestaña actual (ver LibraryTab.availableFields) en vez
  de inflarlos a mano, que sería más código para el mismo resultado.

  Los radio buttons y la casilla son las variantes Material (no android.widget.RadioButton/CheckBox
  a secas) para poder fijarles app:rippleColor directamente: por defecto pulsan en amarillo
  (colorControlActivated/colorPrimary del tema), igual que el mismo arreglo que ya usa
  item_overwrite_checkbox.xml para su propia casilla.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <RadioGroup
        android:id="@+id/sortFieldGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/sortByName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_name"
            android:textColor="@color/um_on_background"
            app:rippleColor="@color/um_ripple_white" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/sortBySongCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_song_count"
            android:textColor="@color/um_on_background"
            app:rippleColor="@color/um_ripple_white" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/sortByDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_duration"
            android:textColor="@color/um_on_background"
            app:rippleColor="@color/um_ripple_white" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/sortByYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_year"
            android:textColor="@color/um_on_background"
            app:rippleColor="@color/um_ripple_white" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/sortByPopularity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_field_popularity"
            android:textColor="@color/um_on_background"
            app:rippleColor="@color/um_ripple_white" />
    </RadioGroup>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/sortInvertOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/sort_invert_order"
        android:textColor="@color/um_on_background"
        app:rippleColor="@color/um_ripple_white" />

</LinearLayout>
