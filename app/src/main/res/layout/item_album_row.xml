<?xml version="1.0" encoding="utf-8"?>
<!--
  Álbum en forma de FILA (carátula cuadrada + título + artista y número de canciones).
  La pestaña de Álbumes los pinta como tarjetas grandes en una rejilla (`item_album_card`), pero en
  los resultados de búsqueda conviven con canciones y artistas, que son filas: una tarjeta ahí
  rompería la lista en dos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/albumCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/cover_placeholder"
        android:contentDescription="@string/album_cover_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/albumTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/um_on_background"
            android:textSize="16sp"
            android:textStyle="italic"
            tools:text="A Night at the Opera" />

        <TextView
            android:id="@+id/albumSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="14sp"
            tools:text="Queen | 12 canciones" />

    </LinearLayout>

</LinearLayout>
