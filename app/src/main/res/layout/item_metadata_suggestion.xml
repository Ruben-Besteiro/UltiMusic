<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila de un candidato de autorrelleno (ver MetadataSuggestionsAdapter). Calco de item_album_row.xml.
  El tipo de publicación (Álbum, Single, EP) no lleva insignia propia: va como sufijo dentro del
  propio título/álbum, igual que hace Apple Music ("... - Single", "... - EP"), así que título y
  subtítulo pueden ocupar varias líneas en vez de truncarse a una.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/suggestionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/suggestionCover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/cover_placeholder"
        android:contentDescription="@string/suggestion_cover_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/suggestionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/um_on_background"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Bohemian Rhapsody" />

        <TextView
            android:id="@+id/suggestionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="14sp"
            tools:text="Queen | A Night at the Opera - Single | 1975" />

    </LinearLayout>

</LinearLayout>
