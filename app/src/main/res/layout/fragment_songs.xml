<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- El resumen de la fonoteca (nº de canciones + duración total) ya NO va aquí como vista fija:
         se pinta como primera fila del propio RecyclerView (ver item_songs_header.xml y
         SongsAdapter) para que haga scroll junto con la lista en vez de quedarse clavado arriba. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSongs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        tools:listitem="@layout/item_song" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="@string/no_songs"
            android:textColor="@color/um_on_surface_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Solo junto al aviso de "no hay canciones" (ver SongsFragment): abre el mismo selector que
             Ajustes > Carpetas de la fonoteca. Sustituye al antiguo segundo diálogo del primer
             arranque. Fondo y texto con el color dinámico, también desde SongsFragment. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMusicFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_songs_add_folder"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/um_gold"
        android:visibility="gone" />

</FrameLayout>