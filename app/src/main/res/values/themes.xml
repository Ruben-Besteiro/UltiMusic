<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de UltiMusic: siempre oscuro (negro) con acento amarillo. -->
    <style name="Base.Theme.UltiMusic" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/um_yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/um_yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/um_background</item>
        <item name="colorSurface">@color/um_surface</item>
        <item name="colorSurfaceVariant">@color/um_surface_variant</item>
        <item name="colorOnBackground">@color/um_on_background</item>
        <item name="colorOnSurface">@color/um_on_background</item>
        <item name="android:statusBarColor">@color/um_background</item>
        <item name="android:navigationBarColor">@color/um_background</item>
        <!-- En Android < 10 el cursor de texto (rayita y gota) no se puede recolorear en tiempo
             real (ver MetadataEditorDialogFragment), así que se fijan en blanco en vez de en el
             amarillo que les daría colorPrimary por defecto. -->
        <item name="android:textCursorDrawable">@drawable/cursor_white</item>
        <item name="android:textSelectHandle">@drawable/handle_teardrop</item>
        <item name="android:textSelectHandleLeft">@drawable/handle_teardrop</item>
        <item name="android:textSelectHandleRight">@drawable/handle_teardrop</item>
    </style>

    <style name="Theme.UltiMusic" parent="Base.Theme.UltiMusic" />

    <!--
      Tema del diálogo del iPod: pantalla completa y fondo transparente. Sin
      android:windowAnimationStyle a propósito: la animación de ventana la fija en código
      IPodNanoDialogFragment.onStart(), porque varía según cómo se haya abierto (ver
      Animation.UltiMusic.IPodEnterOnly).
    -->
    <style name="Theme.UltiMusic.IPodDialog" parent="Theme.UltiMusic">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/um_background</item>
    </style>

    <!--
      Tema de las ventanas a pantalla completa que se abren encima de la principal: el editor de
      metadatos, la ficha de álbum/artista y el buscador. Mismo diálogo deslizante que el
      iPod, pero con fondo opaco porque aquí sí se dibuja una pantalla entera de contenido. La barra
      de estado es transparente para que el color de la cabecera llegue hasta arriba del todo, por
      detrás de la hora y la batería; cada fragmento rellena ese hueco con padding en su toolbar.

      Este estilo estaba definido SOLO en values-night/, así que con el móvil en modo claro no
      existía y abrir cualquiera de esas ventanas reventaba. Aquí está su versión por defecto.
    -->
    <style name="Theme.UltiMusic.FullScreenDialog" parent="Theme.UltiMusic">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/um_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Animation.UltiMusic.SlideUp</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/um_background</item>
    </style>

</resources>
