<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de UltiMusic: siempre oscuro (negro) con acento amarillo. -->
    <style name="Base.Theme.UltiMusic" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.UltiMusic.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.UltiMusic.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.UltiMusic.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.UltiMusic.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.UltiMusic.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.UltiMusic.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.UltiMusic.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.UltiMusic.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.UltiMusic.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.UltiMusic.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.UltiMusic.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.UltiMusic.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.UltiMusic.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.UltiMusic.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.UltiMusic.LabelSmall</item>
        <item name="colorPrimary">@color/um_yellow</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/um_yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/um_background</item>
        <item name="colorSurface">@color/um_surface</item>
        <item name="colorSurfaceVariant">@color/um_surface_variant</item>
        <item name="colorOnBackground">@color/um_on_background</item>
        <item name="colorOnSurface">@color/um_on_background</item>
        <!-- Extremo a extremo SIN enableEdgeToEdge() (que llama a las APIs obsoletas de Android 15):
             barras transparentes, sin contraste forzado y el contenido bajo el recorte de pantalla.
             Los colores de las barras los pintan los scrims de activity_main. En Android 15+ el
             sistema ignora estos atributos y ya fuerza el extremo a extremo. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <!-- En Android < 10 el cursor de texto (rayita y gota) no se puede recolorear en tiempo
             real (ver MetadataEditorDialogFragment), así que se fijan en blanco en vez de en el
             amarillo que les daría colorPrimary por defecto. -->
        <item name="android:textCursorDrawable">@drawable/cursor_white</item>
        <item name="android:textSelectHandle">@drawable/handle_teardrop</item>
        <item name="android:textSelectHandleLeft">@drawable/handle_teardrop</item>
        <item name="android:textSelectHandleRight">@drawable/handle_teardrop</item>
        <item name="recyclerViewStyle">@style/Widget.UltiMusic.RecyclerView</item>
    </style>

    <!-- Splash de Android 12+ (ignorado antes): fondo de la app + logo, que es lo que se ve en el
         arranque en frío, incluido el reinicio de la restauración de la BD (ver MainActivity), en
         vez de una pantalla negra. -->
    <style name="Theme.UltiMusic" parent="Base.Theme.UltiMusic">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/um_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ultimusic_logo</item>
    </style>

    <!--
      Tema del diálogo del iPod: pantalla completa y fondo transparente. Sin
      android:windowAnimationStyle a propósito: la animación de ventana la fija en código
      IPodNanoDialogFragment.onStart(), porque varía según cómo se haya abierto (ver
      Animation.UltiMusic.IPodEnterOnly).
    -->
    <style name="Theme.UltiMusic.IPodDialog" parent="Theme.UltiMusic">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/um_background</item>
    </style>

    <!--
      Tema de las ventanas a pantalla completa que se abren encima de la principal: el editor de
      metadatos, la ficha de álbum/artista y el buscador. Mismo diálogo deslizante que el
      iPod, pero con fondo opaco porque aquí sí se dibuja una pantalla entera de contenido. La barra
      de estado es transparente para que el color de la cabecera llegue hasta arriba del todo, por
      detrás de la hora y la batería; cada fragmento rellena ese hueco con padding en su toolbar.

      Este estilo estaba definido SOLO en values-night/, así que con el móvil en modo claro no
      existía y abrir cualquiera de esas ventanas reventaba. Aquí está su versión por defecto.
    -->
    <style name="Theme.UltiMusic.FullScreenDialog" parent="Theme.UltiMusic">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/um_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Animation.UltiMusic.SlideUp</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/um_background</item>
    </style>

</resources>
