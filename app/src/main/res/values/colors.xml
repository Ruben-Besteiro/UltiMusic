<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Blanco del ripple de los botones "de siempre" de la app (?attr/selectableItemBackground,
         mini-reproductor, filas de listas...): un 20% de opacidad, el mismo que trae de fábrica
         ripple_material_dark. Los controles de Material que pulsan en amarillo fijo por su cuenta
         (los botones de AccentTint.buttons, y las casillas de dialog_settings.xml con
         app:rippleColor) se pasan a este blanco en vez de a @color/white a secas, que al ser opaco
         pulsaba mucho más fuerte que el resto de la app. El MaterialSwitch de esa misma pantalla es
         un caso aparte que no usa este color: ver ThemeOverlay.UltiMusic.SwitchRippleWhite en
         styles.xml. -->
    <color name="um_ripple_white">#33FFFFFF</color>

    <!-- Esquema negro y amarillo de UltiMusic -->
    <color name="um_background">#FF202020</color>
    <color name="um_surface">#FF141414</color>
    <color name="um_surface_variant">#FF1F1F1F</color>
    <!-- El oscuro es el claro con cada canal RGB dividido entre 3 (ver DynamicColor.dim). Esa
         relación no es decorativa: es la regla que aplica AccentTint al teñir con el color de la
         carátula, así que si se cambia um_yellow hay que recalcular este a un tercio. -->
    <color name="um_yellow">#FFFFD000</color>
    <color name="um_yellow_dark">#FF534300</color>
    <color name="um_on_background">#FFF2F2F2</color>
    <color name="um_on_surface_muted">#FFB0B0B0</color>
    <color name="um_divider">#FF404040</color>
    <color name="um_cover_placeholder">#FF000000</color>
    <!-- Velo semitransparente sobre la carátula cuando el iPod muestra la cola encima de ella
         (ver IPodDialogFragment): la carátula se ve de fondo, atenuada, en vez de desaparecer. -->
    <color name="um_queue_scrim">#D9000000</color>
    <!-- Rojo de "esto ha ido mal" (de momento solo el token de Genius que no vale, ver
         GeniusTokenDialogFragment). NO se tiñe con el color dinámico a propósito: la regla del
         proyecto es para lo amarillo, que es decorativo, y un error tiene que leerse como error
         aunque la carátula que suene sea roja o verde. Es el rojo de error de Material sobre fondo
         oscuro, lo bastante claro para leerse encima de um_background. -->
    <color name="um_error">#FFF2B8B5</color>
</resources>
