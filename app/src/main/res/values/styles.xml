<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Esquinas redondeadas para las carátulas (recuadros del wireframe). -->
    <style name="ShapeAppearanceOverlay.UltiMusic.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ipod_display_corner_radius</item>
    </style>

    <!--
      Imagen totalmente circular (artistas). Un "cornerSize" del 50% siempre equivale
      a la mitad del lado, así que redondea del todo sea cual sea el tamaño de la vista.
    -->
    <style name="ShapeAppearanceOverlay.UltiMusic.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Deslizamiento de la ventana del iPod: sube al abrir, baja al cerrar. -->
    <style name="Animation.UltiMusic.SlideUp" parent="">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>

    <!--
      Solo para IPodNanoDialogFragment: igual que Animation.UltiMusic.SlideUp pero sin animación de
      salida, porque esa ventana siempre se cierra a mano con una traslación (ver
      [IPodNanoDialogFragment.animateClose]) para poder arrancarla desde una posición a medio camino
      cuando el cierre viene de un arrastre, en vez de dar un salto. Se aplica en código
      ([IPodNanoDialogFragment.onStart]), no desde el tema, porque además al abrir arrastrando el
      mini-reproductor tampoco debe llevar NINGUNA animación de ventana propia (ver
      [MainActivity.setupMiniPlayerDrag]).
    -->
    <style name="Animation.UltiMusic.IPodEnterOnly" parent="">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
    </style>

    <!--
      Campos del editor de metadatos. El estilo "Filled" de Material es el de la línea inferior
      subrayada del boceto: etiqueta encima y raya debajo.
    -->
    <style name="Widget.UltiMusic.TextField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="android:layout_marginBottom">4dp</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
    </style>

    <!-- Igual, pero desplegando las sugerencias de nombres ya existentes al escribir (sin la
         flechita "▾" del estilo original: no aporta nada aquí y su ripple no seguía el acento). -->
    <style name="Widget.UltiMusic.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="android:layout_marginBottom">4dp</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="endIconMode">none</item>
    </style>

    <!-- Cabecera (no interactiva) de un bloque de campos secundarios del editor. -->
    <style name="Widget.UltiMusic.SectionHeader" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Widget.UltiMusic.SectionTitle" parent="">
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/um_on_surface_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      Fuerza a blanco el ripple (el halo del toque) de un MaterialSwitch, sin tocar el color fijo
      de su pista/pomo (eso lo pinta trackTint/thumbTint, ver DynamicColor.switchTrackTint, y ya
      sigue el acento por su cuenta).

      Ese ripple no lo controla trackTint/thumbTint: lo dibuja el "android:background" que
      MaterialSwitch hereda de Widget.AppCompat.CompoundButton.Switch (?attr/controlBackground),
      cuyo drawable de fábrica (abc_color_highlight_material) usa colorControlActivated cuando el
      interruptor está encendido -que en un tema Material3/MDC como el nuestro equivale a
      colorAccent, y colorAccent a colorSecondary, o sea nuestro amarillo- y colorControlHighlight
      (un blanco translúcido fijo, sin relación con el acento) cuando está apagado. Por eso el
      ripple tocaba en blanco al activar (rama "apagado") y en amarillo al desactivar (rama
      "encendido": el interruptor sigue marcado como encendido mientras se mantiene pulsado, antes
      de soltar el dedo). Redefiniendo aquí colorControlActivated a blanco, las dos ramas quedan
      iguales.
    -->
    <style name="ThemeOverlay.UltiMusic.SwitchRippleWhite" parent="">
        <item name="android:colorControlActivated">@android:color/white</item>
    </style>
</resources>
