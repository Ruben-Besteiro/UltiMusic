<?xml version="1.0" encoding="utf-8"?>
<!-- Anchos de contorno del iPod: los usan tanto los drawables (res/drawable/ipod_*) como
     IPodDialogFragment.tintIPod, que repinta esos contornos con el color de acento cada vez que
     cambia la carátula. Antes ese repintado llevaba los anchos repetidos como números sueltos en
     Kotlin, desincronizados de los que de verdad había en los XML; al compartir el mismo recurso,
     cambiar aquí el ancho de un contorno se ve reflejado en ambos sitios. -->
<resources>
    <dimen name="ipod_stroke_body">6dp</dimen>
    <dimen name="ipod_stroke_display">4dp</dimen>
    <dimen name="ipod_stroke_info_box">2dp</dimen>
    <dimen name="ipod_stroke_button_ring">2dp</dimen>

    <!-- Radio de esquina del recuadro superior del iPod (pantalla). Lo comparte la carátula
         (ShapeAppearanceOverlay.UltiMusic.Cover, en styles.xml) y VideoScreenController, que
         recorta el vídeo a este mismo redondeo para que sus esquinas no sobresalgan del marco. -->
    <dimen name="ipod_display_corner_radius">8dp</dimen>

    <!-- Alto mínimo de @+id/infoBox: en modo carátula solo hace falta lo que ocupan tvTitle+tvMeta,
         pero fijarlo aquí evita que la caja crezca o encoja al pasar a modo cola/lista, donde tvTitle
         se oculta y tvMeta (centrado con android:gravity="center_vertical") pasa a mostrar el aviso
         de la cola, más largo y capaz de ocupar hasta 2 líneas (ver IPodDialogFragment.updateInfoBox
         y R.string.queue_hint_playlist, el más largo de los avisos). -->
    <dimen name="ipod_info_box_min_height">64dp</dimen>

    <!-- Ancho del borde de la "salchicha" de una etiqueta (ver bg_tag_chip.xml/TagsAdapter),
         compartido entre el XML y AccentTint.stroke por el mismo motivo que los ipod_stroke_* de
         arriba. -->
    <dimen name="tag_chip_stroke_width">2dp</dimen>

    <!-- Color picker del editor de etiquetas (ver ui/library/colorpicker/ColorPickerView.kt): tamaño
         del cuadrado de saturación/valor, ancho de la barra vertical de matiz, y tamaño del swatch de
         vista previa del color elegido. -->
    <dimen name="color_picker_sv_size">180dp</dimen>
    <dimen name="color_picker_hue_width">28dp</dimen>
    <dimen name="color_picker_preview_size">56dp</dimen>
</resources>
