    <!--
      Los <plurals> son la forma en que Android elige automáticamente entre "1 canción" y
      "5 canciones" según la cantidad. Se usan en vez de un if en el código porque cada idioma
      tiene sus propias reglas de plural (el ruso tiene tres formas, por ejemplo).
    -->
    <plurals name="song_count">
        <item quantity="one">%d canción</item>
        <item quantity="other">%d canciones</item>
    </plurals>
    <plurals name="album_count">
        <item quantity="one">%d álbum</item>
        <item quantity="other">%d álbumes</item>
    </plurals>

