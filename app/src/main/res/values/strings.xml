    <string name="overwrite_uncheck_all">Desmarcar todo</string>
    <string name="overwrite_field_cover">Carátula</string>
    <!-- Aviso en gris al pie del diálogo cuando la sugerencia no trae alguno de los metadatos que la
         app utiliza (título, álbum, artista(s), año, género(s), nº de pista, nº de disco, carátula o
         productor(es)): %1$s es la lista de los que faltan, ya unidos en una frase ("Año, Género(s)
         y Carátula"). -->
    <string name="overwrite_missing_fields">No se han podido obtener los campos %1$s</string>

    <!-- Diálogo de "Acción requerida" que sale al tocar la varita del editor de CANCIÓN sin token de
         Genius configurado (ver GeniusTokenDialogFragment). No sale en el editor de álbum: ese
         autorrelleno solo usa iTunes, que no pide clave. -->
    <string name="genius_setup_title">Acción requerida</string>
    <string name="genius_setup_intro">El sistema de rellenado automático de metadatos utiliza la API de Genius. Por causas ajenas a UltiMusic, para utilizar esta función debes seguir un proceso corto:</string>
    <string name="genius_setup_step1">1 - Abre este enlace e inicia sesión:</string>
    <string name="genius_setup_step2">2 - Dale a New API Client e introduce lo siguiente:</string>
    <!-- Las etiquetas van con el valor incrustado porque al lado hay un botón que copia justo ese
         valor: separarlos haría dudar de qué se está copiando. -->
    <string name="genius_setup_field_name">App Name: UltiMusic</string>
    <string name="genius_setup_field_url">App Website URL: https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_step3">3 - Hecho esto, abajo del todo dale a Generate Access Token y copia lo que te salga. Se comprobará automáticamente cuando le des a <b>Continuar</b>.</string>
    <!-- Lo que copian los botones: el valor a secas, sin la etiqueta "App Name:" de delante. -->
    <string name="genius_setup_value_name">UltiMusic</string>
    <!-- Valor a copiar/pegar en el campo "App Website URL" del paso 2: el repositorio del proyecto. -->
    <string name="genius_setup_url">https://github.com/Ruben-Besteiro/UltiMusic</string>
    <!-- Enlace que abre el paso 1: la gestión de API Clients de Genius, NO el repositorio de arriba
         (son dos URLs distintas, aunque el paso 2 pida pegar la de GitHub una vez ya está allí). Si
         el usuario no tiene sesión iniciada, Genius redirige sola al login y vuelve aquí después. -->
    <string name="genius_setup_login_url">https://genius.com/api-clients</string>
    <string name="genius_setup_copy">Copiar</string>
    <string name="genius_setup_copied">Copiado</string>
    <string name="genius_setup_exit">Salir</string>
    <string name="genius_setup_continue">Continuar</string>
    <string name="genius_setup_checking">Comprobando el token…</string>
    <string name="genius_setup_ok">Token guardado</string>
    <string name="genius_setup_invalid">Ese token no vale. Comprueba que has copiado el Client Access Token, no el Client ID ni el Client Secret</string>
    <string name="genius_setup_no_token">No hay ningún token copiado. Copia el Client Access Token y vuelve a darle a Continuar</string>
    <string name="genius_setup_no_browser">No se ha encontrado ningún navegador para abrir el enlace</string>
    <!-- Cierre del diálogo largo: deja claro que se puede decir que no. Importa porque el usuario
         puede estar baneado de Genius y no poder completar el proceso aunque quiera. -->
    <string name="genius_setup_optional">Este proceso es opcional, pero si lo rechazas, no podrás sacarle el máximo partido a esta función.</string>

    <!-- Aviso previo cuando el API Client del usuario deja de funcionar (401 invalid_token: lo ha
         borrado, lo ha regenerado, o le han suspendido la cuenta). Al aceptar se abre el diálogo
         largo. Ver GeniusApiErrorDialogFragment. -->
    <string name="genius_error_title">Error con la API de Genius</string>
    <string name="genius_error_message">Se ha producido un error con tu API Client de Genius. Para continuar sacándole el máximo partido al rellenado automático de metadatos, debes crear otro. Disculpa las molestias.</string>

    <!-- Diálogo de "Acción requerida" de la clave de la YouTube Data API, gemelo del de Genius de
         arriba: sale al elegir "Popularidad" en el diálogo de ordenar sin tener clave guardada. Ver
         YouTubeApiKeyDialogFragment. -->
    <string name="youtube_setup_title">Acción requerida</string>
    <string name="youtube_setup_intro">Ordenar por popularidad utiliza la YouTube Data API. Por causas ajenas a UltiMusic, para utilizar esta función debes seguir un proceso corto:</string>
    <string name="youtube_setup_step1">1 - Abre este enlace y crea un proyecto (o elige uno que ya tengas):</string>
    <string name="youtube_setup_step2">2 - En Biblioteca de APIs, busca YouTube Data API v3 y habilítala para ese proyecto (si no lo estaba ya). El paso 3 solo te dejará elegirla si la habilitas primero.</string>
    <string name="youtube_setup_step3">3 - Vuelve al proyecto, dale a Crear credenciales y selecciona YouTube Data API v3 donde te lo pida.</string>
    <string name="youtube_setup_step4">4 - Copia la clave que te dio el paso 3. Se comprobará automáticamente cuando le des a <b>Continuar</b>.</string>
    <string name="youtube_setup_login_url">https://console.cloud.google.com/apis/credentials</string>
    <string name="youtube_setup_exit">Salir</string>
    <string name="youtube_setup_continue">Continuar</string>
    <string name="youtube_setup_checking">Comprobando la clave…</string>
    <string name="youtube_setup_ok">Clave guardada</string>
    <string name="youtube_setup_invalid">Esa clave no vale. Comprueba que has copiado la Clave de API y que YouTube Data API v3 está habilitada en su proyecto</string>
    <string name="youtube_setup_no_key">No hay ninguna clave copiada. Cópiala y vuelve a darle a Continuar</string>
    <!-- Cierre del diálogo: deja claro que se puede decir que no, y que se pierde solo el orden por
         popularidad, nada más de la aplicación. -->
    <string name="youtube_setup_optional">Este proceso es opcional, pero si lo rechazas, no podrás ordenar canciones ni artistas por popularidad.</string>
    <!-- Aviso al tocar "Popularidad" habiendo rechazado ya la configuración antes (SortDialogFragment):
         no se vuelve a insistir con el diálogo, así que hay que decir dónde retomarlo si cambia de
         idea. -->
    <string name="youtube_setup_declined_hint">No podrás ordenar por popularidad sin la clave de la YouTube Data API. Puedes configurarla desde Ajustes &gt; Servicios externos</string>

    <!-- Aviso al tocar "Popularidad" en Canciones con la clave puesta pero ninguna canción con el
