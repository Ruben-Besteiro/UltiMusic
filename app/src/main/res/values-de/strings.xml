    <string name="genius_setup_title">Aktion erforderlich</string>
    <string name="genius_setup_intro">Das automatische Ausfüllen der Metadaten nutzt die Genius-API. Aus Gründen, die außerhalb von UltiMusic liegen, musst du für diese Funktion einen kurzen Vorgang durchlaufen:</string>
    <string name="genius_setup_step1">1 - Öffne diesen Link und melde dich an:</string>
    <string name="genius_setup_step2">2 - Tippe auf New API Client und gib Folgendes ein:</string>
    <string name="genius_setup_field_name">App Name: UltiMusic</string>
    <string name="genius_setup_field_url">App Website URL: https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_step3">3 - Tippe danach ganz unten auf Generate Access Token und kopiere, was angezeigt wird. Es wird automatisch geprüft, wenn du auf <b>Weiter</b> tippst.</string>
    <string name="genius_setup_value_name">UltiMusic</string>
    <string name="genius_setup_url">https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_login_url">https://genius.com/api-clients</string>
    <string name="genius_setup_copy">Kopieren</string>
    <string name="genius_setup_copied">Kopiert</string>
    <string name="genius_setup_exit">Beenden</string>
    <string name="genius_setup_continue">Weiter</string>
    <string name="genius_setup_checking">Token wird geprüft…</string>
    <string name="genius_setup_ok">Token gespeichert</string>
    <string name="genius_setup_invalid">Dieses Token ist ungültig. Prüfe, ob du das Client Access Token kopiert hast und nicht die Client ID oder das Client Secret</string>
    <string name="genius_setup_no_token">Es wurde kein Token kopiert. Kopiere das Client Access Token und tippe erneut auf Weiter</string>
    <string name="genius_setup_no_browser">Es wurde kein Browser zum Öffnen des Links gefunden</string>
    <string name="genius_setup_optional">Dieser Vorgang ist optional, aber wenn du ihn ablehnst, kannst du diese Funktion nicht voll ausschöpfen.</string>
    <string name="genius_error_title">Fehler mit der Genius-API</string>
    <string name="genius_error_message">Bei deinem Genius-API-Client ist ein Fehler aufgetreten. Um das automatische Ausfüllen der Metadaten weiterhin voll zu nutzen, musst du einen neuen erstellen. Entschuldige die Unannehmlichkeiten.</string>
    <string name="youtube_setup_title">Aktion erforderlich</string>
    <string name="youtube_setup_intro">Das Sortieren nach Beliebtheit nutzt die YouTube Data API. Aus Gründen, die außerhalb von UltiMusic liegen, musst du für diese Funktion einen kurzen Vorgang durchlaufen:</string>
    <string name="youtube_setup_step1">1 - Öffne diesen Link und erstelle ein Projekt (oder wähle ein vorhandenes):</string>
    <string name="youtube_setup_step2">2 - Suche in der API-Bibliothek nach YouTube Data API v3 und aktiviere sie für dieses Projekt (falls noch nicht geschehen). In Schritt 3 kannst du sie nur auswählen, wenn du sie vorher aktivierst.</string>
    <string name="youtube_setup_step3">3 - Geh zurück zum Projekt, tippe auf Anmeldedaten erstellen und wähle YouTube Data API v3, wenn du danach gefragt wirst.</string>
    <string name="youtube_setup_step4">4 - Kopiere den Schlüssel aus Schritt 3. Er wird automatisch geprüft, wenn du auf <b>Weiter</b> tippst.</string>
    <string name="youtube_setup_login_url">https://console.cloud.google.com/apis/credentials</string>
    <string name="youtube_setup_exit">Beenden</string>
    <string name="youtube_setup_continue">Weiter</string>
    <string name="youtube_setup_checking">Schlüssel wird geprüft…</string>
