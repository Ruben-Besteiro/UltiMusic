    <string name="genius_setup_title">Potrebna radnja</string>
    <string name="genius_setup_intro">Sistem za automatsko popunjavanje metapodataka koristi Genius API. Zbog razloga izvan kontrole UltiMusica, za korišćenje ove funkcije moraš proći kratak postupak:</string>
    <string name="genius_setup_step1">1 - Otvori ovaj link i prijavi se:</string>
    <string name="genius_setup_step2">2 - Dodirni New API Client i unesi sljedeće:</string>
    <string name="genius_setup_field_name">App Name: UltiMusic</string>
    <string name="genius_setup_field_url">App Website URL: https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_step3">3 - Nakon toga, na samom dnu dodirni Generate Access Token i kopiraj ono što se prikaže. Provjeriće se automatski kad dodirneš <b>Nastavi</b>.</string>
    <string name="genius_setup_value_name">UltiMusic</string>
    <string name="genius_setup_url">https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_login_url">https://genius.com/api-clients</string>
    <string name="genius_setup_copy">Kopiraj</string>
    <string name="genius_setup_copied">Kopirano</string>
    <string name="genius_setup_exit">Izađi</string>
    <string name="genius_setup_continue">Nastavi</string>
    <string name="genius_setup_checking">Provjera tokena…</string>
    <string name="genius_setup_ok">Token sačuvan</string>
    <string name="genius_setup_invalid">Taj token nije važeći. Provjeri jesi li kopirao Client Access Token, a ne Client ID ni Client Secret</string>
    <string name="genius_setup_no_token">Nijedan token nije kopiran. Kopiraj Client Access Token i ponovo dodirni Nastavi</string>
    <string name="genius_setup_no_browser">Nije pronađen pregledač za otvaranje linka</string>
