<?xml version="1.0" encoding="utf-8"?>
<!-- Barra fina gris clara debajo de un EditText, para que se note que es editable sin llamar tanto
     la atención como el subrayado por defecto de Material (que cambia de color con el foco). Fondo
     transparente + los tres lados que no son el de abajo empujados fuera de la vista (insets
     negativos mayores que el grosor del trazo): así del rectángulo entero solo asoma la arista
     inferior. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-4dp"
        android:top="-4dp"
        android:right="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/um_on_surface_muted" />
        </shape>
    </item>
</layer-list>
