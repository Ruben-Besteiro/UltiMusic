<?xml version="1.0" encoding="utf-8"?>
<!-- Swatch de vista previa del color elegido en ColorPickerView. El `solid` de aquí es solo un
     PLACEHOLDER, igual que en bg_tag_chip.xml: ColorPickerView lo muta en runtime con
     View.setBackgroundColor() cada vez que cambia el color elegido. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="@color/um_surface_variant" />
</shape>
