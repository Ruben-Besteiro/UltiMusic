    <string name="genius_setup_url">https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_login_url">https://genius.com/api-clients</string>
    <string name="genius_setup_copy">복사</string>
    <string name="genius_setup_copied">복사됨</string>
    <string name="genius_setup_exit">나가기</string>
    <string name="genius_setup_continue">계속</string>
