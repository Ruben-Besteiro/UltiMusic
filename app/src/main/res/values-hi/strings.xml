    <string name="genius_setup_title">कार्रवाई आवश्यक</string>
    <string name="genius_setup_intro">मेटाडेटा स्वतः भरने की प्रणाली Genius API का उपयोग करती है। UltiMusic से बाहर के कारणों से, इस सुविधा का उपयोग करने के लिए आपको एक छोटी प्रक्रिया पूरी करनी होगी:</string>
    <string name="genius_setup_step1">1 - यह लिंक खोलें और साइन इन करें:</string>
    <string name="genius_setup_step2">2 - New API Client पर टैप करें और यह दर्ज करें:</string>
    <string name="genius_setup_field_name">App Name: UltiMusic</string>
    <string name="genius_setup_field_url">App Website URL: https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_step3">3 - इसके बाद सबसे नीचे Generate Access Token पर टैप करें और जो दिखे उसे कॉपी करें। <b>जारी रखें</b> पर टैप करते ही यह अपने आप जाँचा जाएगा।</string>
    <string name="genius_setup_value_name">UltiMusic</string>
    <string name="genius_setup_url">https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_login_url">https://genius.com/api-clients</string>
    <string name="genius_setup_copy">कॉपी करें</string>
    <string name="genius_setup_copied">कॉपी हो गया</string>
    <string name="genius_setup_exit">बाहर निकलें</string>
    <string name="genius_setup_continue">जारी रखें</string>
    <string name="genius_setup_checking">टोकन जाँचा जा रहा है…</string>
    <string name="genius_setup_ok">टोकन सहेजा गया</string>
    <string name="genius_setup_invalid">यह टोकन मान्य नहीं है। पक्का करें कि आपने Client Access Token कॉपी किया है, Client ID या Client Secret नहीं</string>
    <string name="genius_setup_no_token">कोई टोकन कॉपी नहीं हुआ। Client Access Token कॉपी करें और फिर से जारी रखें पर टैप करें</string>
    <string name="genius_setup_no_browser">लिंक खोलने के लिए कोई ब्राउज़र नहीं मिला</string>
    <string name="genius_setup_optional">यह प्रक्रिया वैकल्पिक है, लेकिन अगर आप मना करते हैं, तो इस सुविधा का पूरा लाभ नहीं उठा पाएँगे।</string>
    <string name="genius_error_title">Genius API में त्रुटि</string>
    <string name="genius_error_message">आपके Genius API Client में एक त्रुटि हुई। मेटाडेटा स्वतः भरने का पूरा लाभ उठाते रहने के लिए आपको नया बनाना होगा। असुविधा के लिए खेद है।</string>
    <string name="youtube_setup_title">कार्रवाई आवश्यक</string>
    <string name="youtube_setup_intro">लोकप्रियता के अनुसार क्रमबद्ध करना YouTube Data API का उपयोग करता है। UltiMusic से बाहर के कारणों से, इस सुविधा का उपयोग करने के लिए आपको एक छोटी प्रक्रिया पूरी करनी होगी:</string>
    <string name="youtube_setup_step1">1 - यह लिंक खोलें और एक प्रोजेक्ट बनाएँ (या अपना कोई मौजूदा प्रोजेक्ट चुनें):</string>
    <string name="youtube_setup_step2">2 - API लाइब्रेरी में YouTube Data API v3 खोजें और उस प्रोजेक्ट के लिए चालू करें (अगर पहले से नहीं है)। चरण 3 में आप इसे तभी चुन पाएँगे जब पहले चालू करेंगे।</string>
    <string name="youtube_setup_step3">3 - प्रोजेक्ट पर वापस जाएँ, क्रेडेंशियल बनाएँ पर टैप करें और पूछे जाने पर YouTube Data API v3 चुनें।</string>
    <string name="youtube_setup_step4">4 - चरण 3 में मिली कुंजी कॉपी करें। <b>जारी रखें</b> पर टैप करते ही यह अपने आप जाँची जाएगी।</string>
    <string name="youtube_setup_login_url">https://console.cloud.google.com/apis/credentials</string>
    <string name="youtube_setup_exit">बाहर निकलें</string>
    <string name="youtube_setup_continue">जारी रखें</string>
    <string name="youtube_setup_checking">कुंजी जाँची जा रही है…</string>
    <string name="youtube_setup_ok">कुंजी सहेजी गई</string>
