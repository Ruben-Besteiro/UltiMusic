    <string name="genius_setup_title">Kailangan ng aksyon</string>
    <string name="genius_setup_intro">Ginagamit ng sistema ng awtomatikong pagpuno ng metadata ang API ng Genius. Dahil sa mga dahilang labas sa UltiMusic, kailangan mong sundin ang isang maikling proseso para magamit ang feature na ito:</string>
    <string name="genius_setup_step1">1 - Buksan ang link na ito at mag-sign in:</string>
    <string name="genius_setup_step2">2 - I-tap ang New API Client at ilagay ang sumusunod:</string>
    <string name="genius_setup_field_name">App Name: UltiMusic</string>
    <string name="genius_setup_field_url">App Website URL: https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_step3">3 - Pagkatapos, sa pinakababa i-tap ang Generate Access Token at kopyahin ang lalabas. Awtomatiko itong susuriin kapag na-tap mo ang <b>Magpatuloy</b>.</string>
    <string name="genius_setup_value_name">UltiMusic</string>
    <string name="genius_setup_url">https://github.com/Ruben-Besteiro/UltiMusic</string>
    <string name="genius_setup_login_url">https://genius.com/api-clients</string>
    <string name="genius_setup_copy">Kopyahin</string>
    <string name="genius_setup_copied">Nakopya</string>
    <string name="genius_setup_exit">Umalis</string>
    <string name="genius_setup_continue">Magpatuloy</string>
    <string name="genius_setup_checking">Sinusuri ang token…</string>
    <string name="genius_setup_ok">Na-save ang token</string>
    <string name="genius_setup_invalid">Hindi wasto ang token na iyan. Tiyaking ang Client Access Token ang kinopya mo, hindi ang Client ID o ang Client Secret</string>
    <string name="genius_setup_no_token">Walang nakopyang token. Kopyahin ang Client Access Token at i-tap ulit ang Magpatuloy</string>
    <string name="genius_setup_no_browser">Walang nahanap na browser para buksan ang link</string>
    <string name="genius_setup_optional">Opsyonal ang prosesong ito, pero kung tatanggihan mo, hindi mo masusulit ang feature na ito.</string>
    <string name="genius_error_title">Error sa API ng Genius</string>
    <string name="genius_error_message">Nagkaroon ng error sa iyong API Client sa Genius. Para patuloy na masulit ang awtomatikong pagpuno ng metadata, kailangan mong gumawa ng bago. Paumanhin sa abala.</string>
    <string name="youtube_setup_title">Kailangan ng aksyon</string>
    <string name="youtube_setup_intro">Ginagamit ng pag-aayos ayon sa kasikatan ang YouTube Data API. Dahil sa mga dahilang labas sa UltiMusic, kailangan mong sundin ang isang maikling proseso para magamit ang feature na ito:</string>
    <string name="youtube_setup_step1">1 - Buksan ang link na ito at gumawa ng project (o pumili ng mayroon ka na):</string>
    <string name="youtube_setup_step2">2 - Sa API Library, hanapin ang YouTube Data API v3 at i-enable ito para sa project na iyon (kung hindi pa). Sa hakbang 3, mapipili mo lang ito kung i-enable mo muna.</string>
    <string name="youtube_setup_step3">3 - Bumalik sa project, i-tap ang Create credentials at piliin ang YouTube Data API v3 kapag hiningi.</string>
    <string name="youtube_setup_step4">4 - Kopyahin ang key na ibinigay sa hakbang 3. Awtomatiko itong susuriin kapag na-tap mo ang <b>Magpatuloy</b>.</string>
    <string name="youtube_setup_login_url">https://console.cloud.google.com/apis/credentials</string>
    <string name="youtube_setup_exit">Umalis</string>
    <string name="youtube_setup_continue">Magpatuloy</string>
    <string name="youtube_setup_checking">Sinusuri ang key…</string>
    <string name="youtube_setup_ok">Na-save ang key</string>
    <string name="youtube_setup_invalid">Hindi wasto ang key na iyan. Tiyaking ang API key ang kinopya mo at naka-enable ang YouTube Data API v3 sa project nito</string>
    <string name="youtube_setup_no_key">Walang nakopyang key. Kopyahin ito at i-tap ulit ang Magpatuloy</string>
    <string name="youtube_setup_optional">Opsyonal ang prosesong ito, pero kung tatanggihan mo, hindi mo maaayos ang mga kanta at artist ayon sa kasikatan.</string>
    <string name="youtube_setup_declined_hint">Hindi ka makakapag-ayos ayon sa kasikatan nang walang key ng YouTube Data API. Puwede mo itong i-set up sa Mga Setting &gt; Mga external na serbisyo</string>
