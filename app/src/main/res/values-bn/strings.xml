    <string name="settings_eq_bass_boost_help_title">বেস বুস্ট</string>
    <string name="settings_eq_bass_boost_help_body">ইকুয়ালাইজারের সবচেয়ে নিচু ব্যান্ড বাড়ানোর বিপরীতে, এই ইফেক্টটি পুরো বেস পরিসরে কাজ করে, যার মধ্যে এই ডিভাইসের কোনো ব্যান্ডের আওতার চেয়েও নিচু ফ্রিকোয়েন্সি আছে। অনেক ফোনে এটি হারমোনিকসও যোগ করে, যাতে এত নিচু ফ্রিকোয়েন্সি বাজাতে না পারা ছোট স্পিকারেও বেস অনুভূত হয়।</string>
    <string name="settings_eq_virtualizer_help_desc">সারাউন্ড সাউন্ড কী</string>
    <string name="settings_eq_virtualizer_help_title">সারাউন্ড সাউন্ড</string>
    <string name="settings_eq_virtualizer_help_body">দুই পাশে দূরে রাখা স্পিকারের অনুকরণ করে স্টেরিওকে প্রশস্ত করে। এটি ফ্রিকোয়েন্সি অনুযায়ী ভলিউম সমন্বয় নয়: এটি বাম ও ডান চ্যানেলকে ভিন্নভাবে মেশায়, যাতে শব্দ মাথার বাইরে থেকে আসছে বলে মনে হয়। ইকুয়ালাইজারের কোনো স্লাইডার এই প্রভাব তৈরি করতে পারে না, কারণ সেগুলো দুই চ্যানেলেই ফ্রিকোয়েন্সি ব্যান্ড সমানভাবে বাড়ায় বা কমায়।</string>
